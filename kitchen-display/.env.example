NODE_ENV=production
KDS_PORT=8080
KDS_PUBLIC_ORIGIN=https://kds.example.com
KDS_COOKIE_SECURE=true
KDS_TRUST_PROXY=true

# Dedicated read-only Partner credential. Never expose this to the browser or commit a value.
KDS_PARTNER_API_BASE=https://nutreeze.com/integration
KDS_PARTNER_API_KEY=
# Preferred on staging: KDS_PARTNER_API_KEY_FILE=/run/secrets/kds_partner_api_key

# Independent display login. Generate the scrypt value with `npm run hash-password`.
KDS_DISPLAY_USERNAME=kitchen-display
KDS_DISPLAY_PASSWORD_HASH=
# Preferred on staging: KDS_DISPLAY_PASSWORD_HASH_FILE=/run/secrets/kds_display_password_hash
KDS_SESSION_TTL_MINUTES=720

# Comma-delimited Partner kitchen identifiers; these become the only selectable values.
KDS_KITCHENS=main
KDS_REFRESH_SECONDS=60
