# Owner switch. "yes" = really send birthday messages; anything else = dry-run (nothing sent).
BIRTHDAY_LIVE=no
# Messages per day (most loyal customers first), seconds between messages, last send time (Kuwait).
DAILY_CAP=20
GAP_MIN=240
GAP_MAX=480
SEND_UNTIL=20:00
# Only customers whose last subscription ended within this many days.
BIRTHDAY_ENDED_DAYS=365
