[Unit]
Description=Nutrezee Partner daily-deliveries → order feed (WP-OPS-06): dry-run + apply for today and tomorrow
Wants=network-online.target docker.service
After=network-online.target docker.service
StartLimitIntervalSec=30min
StartLimitBurst=3

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
# Provides DATABASE_URL (staging) and nothing else; API is the local nutrezee-api container port.
EnvironmentFile=/opt/nutrezee/import.env
Environment=SYNC_TARGET=staging
Environment=FEED_MODE=apply
Environment=ALLOW_APPLY=yes
Environment=API=http://127.0.0.1:3000
WorkingDirectory=/opt/nutrezee/sync
ExecStart=/usr/bin/node /opt/nutrezee/sync/partner-daily-feed.mjs
TimeoutStartSec=20min
NoNewPrivileges=true
PrivateDevices=true
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
