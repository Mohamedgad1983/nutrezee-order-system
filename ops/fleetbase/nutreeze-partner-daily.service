[Unit]
Description=Nutrezee Partner API daily Fleetbase dispatch sync
Wants=network-online.target docker.service
After=network-online.target docker.service
StartLimitIntervalSec=30min
StartLimitBurst=3

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStartPre=/opt/fleetbase/integrations/nutreeze-orders/healthcheck.sh
ExecStart=/opt/fleetbase/integrations/nutreeze-orders/daily-sync.sh
TimeoutStartSec=45min
Restart=on-failure
RestartSec=5min
NoNewPrivileges=true
PrivateDevices=true
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
