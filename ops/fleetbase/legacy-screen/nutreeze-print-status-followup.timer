[Unit]
Description=A81/A84/A87 print guard follow-ups: every 15 min 18:00-00:30 Kuwait, every 5 min 00:30-04:30 (legacy is edited until about 03:30)

[Timer]
# 21:45 UTC (00:45 Kuwait) is left to the main check so its email is never delayed.
OnCalendar=*-*-* 15..20:00/15:00 UTC
OnCalendar=*-*-* 21:00,15,30,35,40,50,55:00 UTC
OnCalendar=*-*-* 22..23:00/5:00 UTC
OnCalendar=*-*-* 00:00/5:00 UTC
OnCalendar=*-*-* 01:00..30/5:00 UTC
Persistent=false

[Install]
WantedBy=timers.target
