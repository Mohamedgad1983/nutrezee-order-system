[Unit]
Description=A81/A84 print guard follow-ups: every 15 min 18:00-02:45 Kuwait, every 5 min 00:30-01:30 (around the 01:00 print)

[Timer]
# 21:45 UTC (00:45 Kuwait) is left to the main check so its email is never delayed.
OnCalendar=*-*-* 15..20:00/15:00 UTC
OnCalendar=*-*-* 21:00,15,30,35,40,50,55:00 UTC
OnCalendar=*-*-* 22:00..30/5:00 UTC
OnCalendar=*-*-* 22:45:00 UTC
OnCalendar=*-*-* 23:00/15:00 UTC
Persistent=false

[Install]
WantedBy=timers.target
