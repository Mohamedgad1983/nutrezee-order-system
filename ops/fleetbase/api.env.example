# Fleetbase api/.env template (NO secrets). On the VPS, /opt/fleetbase/api/.env additionally has a
# real APP_KEY (generated: docker run --rm fleetbase/fleetbase-api:v0.7.48 php artisan key:generate --show),
# is mode 600, and is git-ignored. DB/Redis connection is actually driven by the compose env
# (DATABASE_URL=mysql://root@database/fleetbase, REDIS via cache) — these DB_* are belt-and-suspenders.
APP_NAME=Fleetbase
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://fleetapi.13-140-159-201.sslip.io

LOG_CHANNEL=daily
LOG_LEVEL=info
HTTP_CLIENT_TRACE_ENABLED=false

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=fleetbase
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=socketcluster
CACHE_DRIVER=redis
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=.13-140-159-201.sslip.io

REDIS_HOST=cache
REDIS_PASSWORD=null
REDIS_PORT=6379

CONSOLE_HOST=https://fleet.13-140-159-201.sslip.io
TRUSTED_PROXIES=*

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@13-140-159-201.sslip.io
MAIL_FROM_NAME=Fleetbase
