[Unit]
Description=Nutrezee Partner API same-day Fleetbase dispatch sync (02:00 Kuwait, before 03:00 driver collection)
Wants=network-online.target docker.service
After=network-online.target docker.service
StartLimitIntervalSec=30min
StartLimitBurst=3

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=NUTREEZE_DAILY_MODE=sameday
ExecStartPre=/opt/fleetbase/integrations/nutreeze-orders/healthcheck.sh
ExecStart=/opt/fleetbase/integrations/nutreeze-orders/daily-sync.sh
TimeoutStartSec=45min
NoNewPrivileges=true
PrivateDevices=true
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
