WAHA_API_KEY_PLAIN=__EXISTING_EVOLUTION_API_KEY__
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=__EXISTING_EVOLUTION_API_KEY__
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=__EXISTING_EVOLUTION_API_KEY__
WHATSAPP_DEFAULT_ENGINE=GOWS
WHATSAPP_API_SCHEMA=https
WHATSAPP_API_HOSTNAME=wa.13-140-159-201.sslip.io
WAHA_BASE_URL=https://wa.13-140-159-201.sslip.io
WAHA_PUBLIC_URL=https://wa.13-140-159-201.sslip.io
WAHA_PRINT_QR=false
WAHA_LOG_LEVEL=warn
WAHA_HTTP_LOG_LEVEL=warn
WHATSAPP_RESTART_ALL_SESSIONS=false
TZ=Asia/Kuwait
