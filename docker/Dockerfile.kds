# Nutrezee Kitchen Display — read-only section totals (WP-KDS-01 / A30)
FROM node:22-alpine AS build
WORKDIR /repo
COPY app/package*.json app/
COPY app/apps/api/package.json app/apps/api/
COPY app/apps/admin/package.json app/apps/admin/
COPY app/apps/kds/package.json app/apps/kds/
COPY app/packages/shared/package.json app/packages/shared/
RUN cd app && npm ci --workspaces --include-workspace-root
COPY app/ app/
RUN cd app && npm run build -w apps/kds

FROM nginx:alpine
COPY docker/nginx.kds.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/app/apps/kds/dist /usr/share/nginx/html
EXPOSE 80
